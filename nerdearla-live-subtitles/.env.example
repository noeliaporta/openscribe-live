# Copiar a .env y ajustar. Todo tiene valores por defecto razonables.

# --- Pipeline ---------------------------------------------------------------
# split     = transcribir y luego traducir (usa los backends de abajo)
# gemini_av = Gemini escucha el audio y transcribe+traduce en UNA sola llamada
#             (mas rapido y preciso; no necesita Whisper ni torch). Requiere GEMINI_API_KEY.
PIPELINE=split

# --- Backends (solo modo split) ---------------------------------------------
# whisper = 100% local (sin API) | gemini = API de Google
TRANSCRIBE_BACKEND=whisper
# argos = 100% local (sin API) | gemini = API de Google
TRANSLATE_BACKEND=argos

# --- Whisper local ----------------------------------------------------------
# tiny/base = rápido (tiempo real en CPU) | small/medium/large-v3 = mas preciso
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# --- Gemini (para gemini_av o backends gemini) ------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Reintentos ante errores transitorios (503/429 por alta demanda)
GEMINI_RETRIES=3

# --- Audio ------------------------------------------------------------------
SAMPLE_RATE=16000
CHUNK_SECONDS=4.0

# --- Glosario de términos técnicos / nombres propios ------------------------
GLOSSARY_PATH=glossary.json

# --- Servidor ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
